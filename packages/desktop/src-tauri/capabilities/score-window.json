{
  "identifier": "score-window",
  "description": "Score windows load the local score page; it may only run the score assistant for its own window.",
  "windows": ["score-*"],
  "remote": {
    "urls": ["http://127.0.0.1:*/*"]
  },
  "permissions": [
    "allow-assistant-send",
    "allow-assistant-stop",
    "core:event:allow-listen",
    "core:event:allow-unlisten"
  ]
}

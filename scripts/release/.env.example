# Public update feed used by the desktop updater.
OSSIA_RELEASES_URL=https://releases.example.com

# Optional object-key prefix. Leave empty when the bucket root is the public feed root.
OSSIA_RELEASES_PREFIX=

# Tencent COS bucket name includes the APPID, for example example-1250000000.
OSSIA_RELEASES_BUCKET=
OSSIA_RELEASES_REGION=ap-guangzhou
OSSIA_RELEASES_SECRET_ID=
OSSIA_RELEASES_SECRET_KEY=

# Optional STS token. Leave empty for a long-lived CAM user key.
OSSIA_RELEASES_SECURITY_TOKEN=

# Anonymous update checks need public-read objects.
OSSIA_RELEASES_ACL=public-read
